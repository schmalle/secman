#!/usr/bin/env bash
# Render the effective egress allowlist.
#
# Three sources, one output, so that the firewall and every inspection command
# read exactly the same list:
#
#   /etc/secman-dev/egress/allowlist.txt        image default, replaced on rebuild
#   /etc/secman-dev/egress/allowlist.local.txt  site-local, survives a rebuild
#   $SECMAN_EGRESS_EXTRA_DOMAINS                --allow-domain from the host script
#
# Two line shapes survive: a hostname, or an IPv4 address/CIDR. A leading dot is
# stripped — without a proxy there is no wildcard matching to attach it to, so
# `.example.com` is simply `example.com` and covers no subdomain. Anything else
# is dropped rather than passed through: this file feeds `iptables -d`, and a
# malformed entry there is a rule that either fails to install or installs
# something nobody intended.
set -euo pipefail

OUT=${1:-/run/secman-dev/egress/allowlist.rendered}
BASE=${SECMAN_EGRESS_ALLOWLIST:-/etc/secman-dev/egress/allowlist.txt}
LOCAL=${SECMAN_EGRESS_ALLOWLIST_LOCAL:-/etc/secman-dev/egress/allowlist.local.txt}
mkdir -p "$(dirname "$OUT")"

[ -r "$BASE" ] || { echo "render-egress-allowlist: cannot read $BASE" >&2; exit 1; }

# `|| true` on the optional sources: a missing local allowlist is a normal state,
# and `set -e` plus pipefail would otherwise turn it into a failed start with no
# diagnostic. The mandatory source is checked above.
{
    cat "$BASE" || true
    cat "$LOCAL" 2>/dev/null || true
    printf '%s\n' "${SECMAN_EGRESS_EXTRA_DOMAINS:-}" | tr ',' '\n' | tr ' ' '\n'
} \
  | sed -e 's/#.*$//' -e 's/[[:space:]]//g' -e 's/^\.//' \
  | { grep -E '^([A-Za-z0-9][A-Za-z0-9.-]*\.[A-Za-z]{2,}|[0-9]{1,3}(\.[0-9]{1,3}){3}(/[0-9]{1,2})?)$' || true; } \
  | sort -u > "$OUT.tmp"

# Never install an empty policy. Failing here leaves the previous ruleset in
# place, which is the safe direction; writing an empty list would take the whole
# toolchain offline on the next refresh.
if [ ! -s "$OUT.tmp" ]; then
    rm -f "$OUT.tmp"
    echo "render-egress-allowlist: refusing to write an empty allowlist" >&2
    exit 1
fi
mv "$OUT.tmp" "$OUT"
wc -l < "$OUT" | tr -d ' '
