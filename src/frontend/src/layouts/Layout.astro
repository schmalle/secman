---
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import Sidebar from '../components/Sidebar.tsx';
import Header from '../components/Header.tsx'; // Import Header component
import 'bootstrap/dist/css/bootstrap.min.css';
import 'bootstrap-icons/font/bootstrap-icons.css'; // Import Bootstrap Icons CSS
// Scandinavian Design System
import '../styles/theme.css';
import '../styles/bootstrap-overrides.css';

interface Props {
    title?: string;
}

const { title = "SecMan" } = Astro.props; // Updated default title

// Paths reachable without a login. This is an AUTH POLICY list: it controls the redirect and the
// 401 interception below, nothing else.
const publicPaths = ['/login', '/requirements/download']; // Add other public paths if needed

// Paths that never get app chrome, signed in or not. This is a LAYOUT list, deliberately separate
// from `publicPaths`: the two coincided while /login was the only public page, and collapsing them
// into one flag is what hid the sidebar from signed-in users on /requirements/download. A page can
// be public *and* still deserve the sidebar for someone who is logged in.
const chromelessPaths = ['/login'];

// Check auth status on the server-side for initial load
let user = null;
let error = null;
try {
    // Use Astro.cookies API to potentially check session, but Play's session is HttpOnly by default.
    // A better approach is an API call, but that's client-side.
    // For SSR/initial load protection, we rely on redirecting *after* client-side check.
    // Or, implement a middleware in Astro if more robust SSR protection is needed.
} catch (e: any) { // Add type annotation
    error = e.message;
    console.error("Error checking auth status server-side (placeholder):", e);
}

const isPublicPage = publicPaths.includes(Astro.url.pathname);
const isChromeless = chromelessPaths.includes(Astro.url.pathname);
const requiresRedirect = !user && !isPublicPage;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" /> 
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		{/* Note: frame-ancestors cannot be delivered via <meta> per CSP spec — it is enforced
		    server-side via the X-Frame-Options: DENY / Content-Security-Policy headers set by
		    the Astro middleware (frontend) and SecurityHeadersFilter (backend API responses). */}
		<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline' cdn.jsdelivr.net; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' cdn.jsdelivr.net; font-src 'self' cdn.jsdelivr.net; img-src 'self' data: blob:; connect-src 'self' cdn.jsdelivr.net; form-action 'self'; base-uri 'self'; object-src 'none';" />
		<title>{title}</title>
        {/*
          Decide the app chrome BEFORE first paint.

          `sessionStorage` is synchronous, so this runs and stamps the class while the head is
          still parsing — the very first paint is already correct. Doing it after hydration
          instead would show the anonymous layout first and then jump, which is worse than the
          missing sidebar it fixes.

          It reads the same `sessionStorage['user']` that Sidebar.tsx sources its roles from (via
          utils/permissions), so visibility and contents can never disagree — there is no state
          where the sidebar appears but renders empty. It holds no token; the JWT stays in the
          HttpOnly secman_auth cookie. This is presentation only: every destination behind these
          links is RBAC-enforced at the controller.
        */}
        <script is:inline>
            try {
                if (sessionStorage.getItem('user')) {
                    document.documentElement.classList.add('has-session');
                }
            } catch (e) {
                // sessionStorage can throw in hardened/private modes — fall back to no chrome.
            }
        </script>
        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        <style>
            .main-layout {
                display: flex;
                min-height: 100vh;
                padding-top: 80px; /* Account for larger fixed navbar with bigger logo */
            }
            .content-wrapper {
                flex-grow: 1;
                display: flex;
            }
            /*
              A public page renders the sidebar markup unconditionally and hides it for visitors
              with no session. Only the no-session case is styled, so a signed-in visitor gets
              Bootstrap's own column widths untouched rather than a second set to keep in step.
            */
            html:not(.has-session) .main-layout.public-page .sidebar-col {
                /* `!important` to outrank Bootstrap's `d-md-block`, which is itself
                   `display: block !important` at >=768px. Between two !important rules the more
                   specific one wins, and this selector is far more specific. */
                display: none !important;
            }
            html:not(.has-session) .main-layout.public-page .main-col {
                width: 100%;
            }
        </style>
	</head>
	<body>
        <Header client:load />
		<div class:list={["main-layout", { "public-page": isPublicPage }]}>
			<div class="container-fluid content-wrapper">
				<div class="row w-100">
					{/*
					  Rendered on public pages too, then hidden by CSS when there is no session.
					  `client:visible` makes that free: the island hydrates on intersection, and a
					  display:none element never intersects — so an anonymous visitor downloads and
					  runs no sidebar JS, exactly as when the markup was absent.
					*/}
					{!isChromeless && (
						<div class="col-md-3 col-lg-2 d-md-block bg-light sidebar sidebar-col">
							<Sidebar client:visible />
						</div>
					)}
					{/* Main content area */}
					<main class={isChromeless ? "col-12" : "main-col col-md-9 ms-sm-auto col-lg-10 px-md-4 pt-4 pb-5"}>
						<slot />
						<Footer />
					</main>
				</div>
			</div>
		</div>

        <!-- Bootstrap JS Bundle -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

        {/* Set up axios interceptor for JWT auth - must run before React components */}
        <script>
            import { setupCSRFProtection } from '../utils/csrf';
            setupCSRFProtection();
        </script>

        {/* Session keep-alive script - properly bundled by Astro */}
        <script>
            import '../scripts/sessionKeepAlive';
        </script>

        {/* Client-side Auth Check and Redirect */}
        <script define:vars={{ isPublicPage }}>
            // window.currentUser starts as `undefined` and is left that way until
            // checkAuthAndRedirect() resolves. React islands rely on the
            // undefined → resolved transition (and the `userLoaded` event) to
            // distinguish "auth pending" from "auth resolved with no user".
            // Pre-setting it to null caused a race where Edge/IE clients (slower
            // network or different hydration scheduling) hydrated React islands
            // before this fetch returned, made the islands treat null as "no
            // user", and rendered Access Denied permanently.

            // Migration cleanup: remove legacy authToken from localStorage and cookies.
            // Authentication is now handled solely via the HttpOnly secman_auth cookie.
            localStorage.removeItem('authToken');
            document.cookie = 'authToken=; path=/; expires=Thu, 01 Jan 1970 00:00:00 GMT';

            function resolveAuth(user) {
                window.currentUser = user;
                window.dispatchEvent(new CustomEvent('userLoaded'));
            }


            // Bounce to login while remembering where the user was headed, so an emailed
            // deep link (e.g. /risk-assessments?assessmentId=42) survives the login round
            // trip instead of dumping the user on the dashboard. Only the path+query is
            // carried — Login.tsx re-validates it as a same-origin relative path before
            // using it, so this cannot become an open redirect.
            function redirectToLogin() {
                const target = window.location.pathname + window.location.search;
                const suffix = (target && target !== '/')
                    ? '?redirect=' + encodeURIComponent(target)
                    : '';
                window.location.href = '/login' + suffix;
            }

            // The pre-paint script showed the chrome on the strength of sessionStorage alone.
            // If the session turns out to be gone, take it back down — but never redirect: on a
            // public page an anonymous visitor is entitled to be here.
            function clearSessionChrome() {
                document.documentElement.classList.remove('has-session');
            }

            async function checkAuthAndRedirect() {
                try {
                    // Check for user data in sessionStorage (indicates a logged-in session)
                    // The actual JWT token is stored in an HttpOnly cookie (secman_auth)
                    // for XSS protection and is sent automatically with credentials: 'include'
                    const userStr = sessionStorage.getItem('user');
                    if (!userStr) {
                        if (isPublicPage) {
                            // Signal "no user" so any island that mounts here resolves
                            // immediately instead of waiting out its timeout.
                            clearSessionChrome();
                            resolveAuth(null);
                            return;
                        }
                        // No user data, redirect to login
                        console.log('No user data found, redirecting to /login');
                        redirectToLogin();
                        return;
                    }

                    // Validate session with backend (cookie sent automatically)
                    const response = await fetch('/api/auth/status', {
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        credentials: 'include'  // Sends HttpOnly cookie automatically
                    });
                    if (!response.ok) {
                        if (response.status === 401) {
                             sessionStorage.removeItem('user');
                             if (isPublicPage) {
                                 clearSessionChrome();
                                 resolveAuth(null);
                                 return;
                             }
                             console.log('Not authenticated, clearing user data and redirecting to /login');
                             redirectToLogin();
                             return;
                        }
                        // Other server errors: signal "no user" so islands stop
                        // waiting and render their unauthorized state instead of
                        // hanging on the 5s timeout.
                        console.error('Auth status check failed:', response.statusText);
                        resolveAuth(null);
                        return;
                    }
                    const user = await response.json();
                    console.log('User authenticated:', user.username, 'Roles:', user.roles);
                    resolveAuth(user);
                } catch (error) {
                    // Network errors during navigation are expected; don't
                    // redirect, but do resolve so islands don't hang.
                    console.warn('Failed to fetch auth status:', error);
                    resolveAuth(null);
                }
            }
            checkAuthAndRedirect();

            // Global fetch wrapper to handle 401 Unauthorized
            const originalFetch = window.fetch;
            window.fetch = async (...args) => {
                let response = await originalFetch(...args);
                if (response.status === 401 && !isPublicPage) {
                    console.log('Intercepted 401, redirecting to /login');
                    redirectToLogin();
                    // Return a dummy response or throw an error to prevent further processing
                    return new Response(null, { status: 401, statusText: 'Unauthorized' });
                }
                return response;
            };
        </script>
	</body>
</html>

<style is:global>
    /* Global styles for the application */
    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
    }
    
    /* Ensure main content area takes full height and handles scrolling properly */
    main {
        min-height: calc(100vh - 80px); /* Account for header height */
        display: flex;
        flex-direction: column;
    }
    
    /* Push footer to bottom */
    main > footer {
        margin-top: auto;
    }
    
    /* Sidebar adjustments */
    .sidebar {
        position: sticky;
        top: 80px; /* Account for fixed header */
        height: calc(100vh - 80px);
        overflow-y: auto;
    }
</style>
