---
// The emailed token authorizes the respondent; this page must not require a login.
import PublicLayout from '../../layouts/PublicLayout.astro';
import ResponseInterface from '../../components/ResponseInterface';

const { token } = Astro.params;

if (!token) {
  return Astro.redirect('/');
}
---

<PublicLayout title="Risk Assessment Response">
    <ResponseInterface token={token} client:load />
</PublicLayout>
