---
import Layout from '../../layouts/Layout.astro';
import SlackConfigManagement from '../../components/SlackConfigManagement';
import TelegramConfigManagement from '../../components/TelegramConfigManagement';

/**
 * Workspace-level chat configuration (Slack and Telegram bot credentials).
 *
 * Route: /admin/chat-config
 * Access: ADMIN — enforced by the /admin middleware and by `@Secured("ADMIN")` on
 * SlackConfigController / TelegramConfigController.
 */
---

<Layout title="Chat Configuration">
  <div class="container-fluid">
    <div class="row">
      <div class="col-lg-9">
        <h1 class="mt-4 mb-2">Chat Configuration</h1>
        <p class="text-muted mb-4">
          Workspace bot credentials for chat notifications. Both are optional: users can
          always fall back to their own Slack webhook or their own Telegram bot.
        </p>
      </div>
    </div>
    <div class="row g-4">
      <div class="col-lg-6">
        <SlackConfigManagement client:load />
      </div>
      <div class="col-lg-6">
        <TelegramConfigManagement client:load />
      </div>
    </div>
  </div>
</Layout>
