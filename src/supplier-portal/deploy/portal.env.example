SUPPLIER_PUBLIC_LISTEN=:8443
SUPPLIER_PUBLIC_ORIGIN=https://suppliers.example.test
SUPPLIER_PUBLIC_PAUSED=true
SUPPLIER_PUBLIC_CERT=/etc/secman-supplier/tls/public.crt
SUPPLIER_PUBLIC_KEY=/etc/secman-supplier/tls/public.key
SUPPLIER_INTEGRATION_LISTEN=:9443
SUPPLIER_INTEGRATION_CERT=/etc/secman-supplier/tls/integration.crt
SUPPLIER_INTEGRATION_KEY=/etc/secman-supplier/tls/integration.key
SUPPLIER_INTEGRATION_CLIENT_CA=/etc/secman-supplier/tls/main-client-ca.crt
SUPPLIER_STATE_DIR=/var/lib/secman-supplier
