# systemd unit for secman-relay.
#
# The hardening below is not decoration: this process is internet-facing, so
# the assumption is that it will one day be the thing that gets popped. Every
# directive narrows what happens next.

[Unit]
Description=secman mobile relay
Documentation=https://github.com/schmalle/secman/blob/main/docs/RELAY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/secman-relay
Restart=always
RestartSec=5s

# Secrets come from a 0600 root-owned file, never from the unit: a unit file is
# world-readable and shows up in `systemctl cat`.
EnvironmentFile=/etc/secman-relay/relay.env

# DynamicUser gives a fresh uid per start and, with StateDirectory, a private
# /var/lib/secman-relay that no other service can read.
DynamicUser=yes
StateDirectory=secman-relay
StateDirectoryMode=0700
Environment=RELAY_STATE_DIR=/var/lib/secman-relay

# Only needed to bind :80 for the ACME HTTP-01 challenge. Drop both lines when
# RELAY_TLS_MODE is "file" or "off", or when the listener is above 1024.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# The relay is small and single-purpose; these bound a runaway rather than
# tuning for load.
LimitNOFILE=8192
TasksMax=256

[Install]
WantedBy=multi-user.target
