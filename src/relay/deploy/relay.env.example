# Example environment for secman-relay.
#
# Install as /etc/secman-relay/relay.env, owned by root, mode 0600. The three
# secrets below must come from your secret manager (pass-cli in this project),
# not from a file in git.
#
#   openssl rand -base64 32
#
# Full reference: docs/ENVIRONMENT.md, section "Mobile relay".

# --- listeners -------------------------------------------------------------
# The public (mobile) plane. Any port; :8443 is only a default.
RELAY_LISTEN_ADDR=:8443

# Bind the ingest plane to a private interface so the internet cannot reach it
# at all. Strongly recommended. Leave unset to mount /ingest on the public
# listener, protected by token + HMAC alone.
#RELAY_INGEST_LISTEN_ADDR=10.0.1.7:9443

# --- TLS -------------------------------------------------------------------
# acme | file | off
RELAY_TLS_MODE=acme
RELAY_ACME_DOMAINS=relay.example.com
RELAY_ACME_EMAIL=ops@example.com
RELAY_ACME_ACCEPT_TOS=true
RELAY_ACME_HTTP01_ADDR=:80
# Point at staging while testing a deployment; production rate limits are low
# enough to lock you out for a week.
#RELAY_ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# Behind an AWS ALB or an ingress controller instead:
#RELAY_TLS_MODE=off
#RELAY_PLAINTEXT_ACK=true
#RELAY_TRUSTED_PROXY_CIDRS=10.0.0.0/16

# An existing certificate, reloaded when it changes on disk:
#RELAY_TLS_MODE=file
#RELAY_TLS_CERT_FILE=/etc/ssl/relay.crt
#RELAY_TLS_KEY_FILE=/etc/ssl/relay.key

# --- ingest credentials (secrets) -------------------------------------------
# Must match SECMAN_RELAY_TOKEN / SECMAN_RELAY_HMAC_KEY on the secman side, and
# must differ from each other: a leaked bearer token alone must not be enough
# to forge a snapshot.
RELAY_INGEST_TOKEN=REPLACE_ME
RELAY_INGEST_HMAC_KEY=REPLACE_ME
#RELAY_INGEST_ALLOWED_CIDRS=10.0.0.0/16

# --- device tokens (secret) --------------------------------------------------
RELAY_TOKEN_SIGNING_KEY=REPLACE_ME
RELAY_TOKEN_TTL=15m

# --- identity providers ------------------------------------------------------
RELAY_APPLE_ENABLED=true
RELAY_APPLE_AUDIENCES=io.secman.status

RELAY_GOOGLE_ENABLED=false
#RELAY_GOOGLE_AUDIENCES=123456-abcdef.apps.googleusercontent.com

# GitHub cannot be used by privileged accounts. The client secret stays here and
# never reaches a device.
RELAY_GITHUB_ENABLED=false
#RELAY_GITHUB_CLIENT_ID=
#RELAY_GITHUB_CLIENT_SECRET=
#RELAY_GITHUB_REDIRECT_URI=https://relay.example.com/api/v1/auth/github/callback

RELAY_APP_CALLBACK_SCHEME=secman-relay

# The deployment rule: an ADMIN signs in with Apple or Google, never GitHub and
# never a typed enrollment code. The relay refuses to start if a privileged role
# has no reachable strong provider.
RELAY_PRIVILEGED_ROLES=ADMIN
RELAY_STRONG_PROVIDERS=apple,google
RELAY_ENROLLMENT_CODES_ENABLED=true

# --- limits ------------------------------------------------------------------
RELAY_SNAPSHOT_MAX_AGE=15m
RELAY_MAX_BODY_BYTES=4194304
RELAY_RATE_LIMIT_RPS=5
RELAY_RATE_LIMIT_BURST=20
RELAY_MAX_DEVICES=500
RELAY_LOG_LEVEL=info
