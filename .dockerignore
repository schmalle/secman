# Keep the Docker build context lean. The context is the repository root
# (both docker/aws/Dockerfile and the docker/{backend,frontend} images build
# from root).

# VCS / IDE / agent metadata
.git
.gitignore
.idea
.vscode
.claude
.agents
.specify
specs

# Dependency + build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/.gradle
**/.astro
src/frontend/.astro

# Logs and local artifacts
**/*.log
.e2e-logs
logs
test-results
playwright-report

# Docs and misc not needed inside images
docs
*.md
!docker/README.md
tests
